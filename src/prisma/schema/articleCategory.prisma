model ArticleCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visibilityAdmin     Visibility @relation(name: "ArticleCategoryAdminVisibility", fields: [visibilityAdminId], references: [id], onDelete: Restrict)
  visibilityAdminId   Int        @unique
  visibilityRegular   Visibility @relation(name: "ArticleCategoryRegularVisibility", fields: [visibilityRegularId], references: [id], onDelete: Restrict)
  visibilityRegularId Int        @unique

  @@unique([id, name])
}
