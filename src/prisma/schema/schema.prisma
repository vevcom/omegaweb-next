generator omegawebnext {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  // Generate outside of src folder.
  output          = "../../../generated/pn-prisma"
}

datasource db {
  provider = "postgresql"
}

// Writes the table map: which tables a model and its relations are, and what the database does to
// other tables on a delete or a key change. See src/prisma/tableWatch.
generator tableMap {
  provider = "node ./src/prisma/tableWatch/tableMapGenerator.cjs"
  output   = "../../../generated/table-map"
}
