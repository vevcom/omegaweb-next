/// An address on one of our mail domains, which an alias or a user has. An address has one row, so
/// it is one alias's or one user's and never both. The owner keeps the address in a column of its
/// own that refers to the row, which follows when the address changes. See services/mail/address.
model MailAddress {
  id                     Int      @id @default(autoincrement())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  address                String   @unique
  forwardsToPrivateEmail Boolean  @default(true)

  alias MailAlias?
  user  User?
}

model MailAlias {
  id                Int         @id @default(autoincrement())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  address           String      @unique
  mailAddress       MailAddress @relation(fields: [address], references: [address], onDelete: Restrict, onUpdate: Cascade)
  description       String      @default("")
  ownerVisibility   Visibility  @relation(name: "MailAliasOwnerVisibility", fields: [ownerVisibilityId], references: [id], onDelete: Restrict)
  ownerVisibilityId Int         @unique
  /// Whether the alias also keeps its mail in a shared mailbox on the mail server, which everyone who receives it may open.
  /// The id of that mailbox's group account on the mail server, once the sync has created it.
  mailboxAccountId  String?     @unique

  mailingLists        MailAliasMailingList[]
  notificationChannel NotificationChannel[]
}

model MailAliasMailingList {
  mailAliasId   Int
  mailAlias     MailAlias   @relation(fields: [mailAliasId], references: [id], onDelete: Cascade)
  mailingListId Int
  mailingList   MailingList @relation(fields: [mailingListId], references: [id], onDelete: Cascade)

  @@unique([mailAliasId, mailingListId])
}

model MailingList {
  id                Int        @id @default(autoincrement())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  name              String     @unique
  description       String     @default("")
  ownerVisibility   Visibility @relation(name: "MailingListOwnerVisibility", fields: [ownerVisibilityId], references: [id], onDelete: Restrict)
  ownerVisibilityId Int        @unique

  mailAliases         MailAliasMailingList[]
  groups              MailingListGroup[]
  users               MailingListUser[]
  mailAddressExternal MailingListMailAddressExternal[]
}

model MailingListGroup {
  mailingListId Int
  mailingList   MailingList @relation(fields: [mailingListId], references: [id], onDelete: Cascade)
  groupId       Int
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([mailingListId, groupId])
}

model MailingListUser {
  mailingListId Int
  mailingList   MailingList @relation(fields: [mailingListId], references: [id], onDelete: Cascade)
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mailingListId, userId])
}

model MailAddressExternal {
  id          Int    @id @default(autoincrement())
  address     String @unique
  description String @default("")

  mailingLists MailingListMailAddressExternal[]
}

model MailingListMailAddressExternal {
  mailingListId         Int
  mailingList           MailingList         @relation(fields: [mailingListId], references: [id], onDelete: Cascade)
  mailAddressExternalId Int
  mailAddressExternal   MailAddressExternal @relation(fields: [mailAddressExternalId], references: [id], onDelete: Cascade)

  @@unique([mailingListId, mailAddressExternalId])
}
