model Ombul {
  id           Int          @id @default(autoincrement())
  name         String
  description  String?
  paragraph    CmsParagraph @relation(fields: [paragraphId], references: [id])
  paragraphId  Int          @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // The name of the pdf in the store, of the purpose OMBUL.
  fsLocation   String       @unique
  file         StoreFile    @relation(fields: [fsLocation], references: [name], onDelete: Restrict)
  year         Int
  issueNumber  Int
  coverImage   Image        @relation(fields: [coverImageId], references: [id], onDelete: Restrict)
  coverImageId Int          @unique

  @@unique([year, name])
  @@unique([year, issueNumber])
}
