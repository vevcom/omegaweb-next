model Revue {
  id   Int    @id @default(autoincrement())
  year Int    @unique
  // The name of a revue is the name of its article, which is where it is changed.
  name String @unique

  article   Article @relation(fields: [articleId, name], references: [id, name], onDelete: Restrict, onUpdate: Cascade)
  articleId Int     @unique

  // The palette the revue's theme is derived from. A check constraint holds each to #rrggbb in lower case.
  themeBackground String
  themePrimary    String
  themeSecondary  String
  themeAccent     String

  groups RevueGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, name])
}
