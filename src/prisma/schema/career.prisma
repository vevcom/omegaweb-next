enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  OTHER
}

enum CompanySponsorTier {
  MAIN
  SPONSOR
  NONE
}

model JobAd {
  id                  Int          @id @default(autoincrement())
  article             Article      @relation(fields: [articleId, articleName], references: [id, name], onDelete: Cascade)
  articleId           Int
  articleName         String
  description         String?
  company             Company      @relation(fields: [companyId], references: [id])
  companyId           Int
  type                JobType
  location            String?
  applicationDeadline DateTime?
  active              Boolean      @default(true)
  rollingDueDate      Boolean      @default(false) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, articleName])
}

model Company {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String
  logo        CmsImage           @relation(fields: [logoId], references: [id])
  logoId      Int                @unique
  website     String?
  sponsorTier CompanySponsorTier @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  JobAd     JobAd[]

  @@index([sponsorTier])
}

// A department of the team on the career site's about page, with its description and its persons.
model CareerTeamDepartment {
  id          Int          @id @default(autoincrement())
  name        String
  paragraph   CmsParagraph @relation(fields: [paragraphId], references: [id], onDelete: Restrict)
  paragraphId Int          @unique
  order       Int          @unique @default(autoincrement())
  persons     CmsPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
