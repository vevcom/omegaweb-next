enum CompanySponsorTier {
  MAIN
  SPONSOR
  NONE
}

model Company {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String
  logo        CmsImage           @relation(fields: [logoId], references: [id])
  logoId      Int                @unique
  website     String?
  sponsorTier CompanySponsorTier @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  JobAd     JobAd[]

  @@index([sponsorTier])
}
