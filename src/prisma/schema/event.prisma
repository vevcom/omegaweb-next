enum EventCanView {
  CAN_REGISTER
  ALL
}

model Event {
  id             Int               @id @default(autoincrement())
  name           String
  paragraph      CmsParagraph      @relation(fields: [cmsParagraphId], references: [id])
  cmsParagraphId Int               @unique
  coverImage     CmsImage          @relation(fields: [coverImageId], references: [id])
  coverImageId   Int               @unique
  eventTagEvents EventTagEvent[]
  location       String?
  locationMap    EventLocationMap?

  eventStart          DateTime
  eventEnd            DateTime
  canBeViewedBy       EventCanView
  hostedByCommittee   Committee?     @relation(fields: [hostedByCommitteeId], references: [id])
  hostedByCommitteeId Int?
  createdBy           User?          @relation(fields: [createdById], references: [id])
  createdById         Int?
  // The account a paid event is paid into. Payments fail with a clear error until someone
  // administrating the event links one.
  ledgerAccount       LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId     Int?

  // The event takes registration when it has quotas.
  quotas              EventRegistrationQuota[]
  waitingList         Boolean
  // Registrations without a place, queueing for one in any quota they pass.
  waitingListRegistrations EventRegistration[]
  // Registrants cannot unregister themselves. Only those who administrate the event remove a registration.
  bindingRegistration Boolean                  @default(false)
  takesPayment        Boolean                  @default(false)
  // Set exactly when the event takes payment.
  paymentStart        DateTime?
  paymentEnd          DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cabinEvent Booking[]

  published Boolean @default(false)

  visibilityAdmin   Visibility @relation(name: "EventAdminVisibility", fields: [visibilityAdminId], references: [id], onDelete: Restrict)
  visibilityAdminId Int        @unique

  // Legacy from OW basic database
  company     Boolean @default(false) // If a plus one is allowed
  lead        String?
  extraFields Json?   @db.Json
}

enum MapProvider {
  MAZEMAP
  OPENSTREETMAP
}

model EventLocationMap {
  eventId   Int         @id
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider  MapProvider
  url       String?
  latitude  Float?
  longitude Float?
}

model EventTagEvent {
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  tag     EventTag @relation(fields: [tagId], references: [id])
  tagId   Int

  @@id([eventId, tagId])
}

enum SpecialEventTags {
  COMPANY_PRESENTATION
}

model EventTag {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  description   String
  colorR        Int
  colorG        Int
  colorB        Int
  special       SpecialEventTags? @unique
  EventTagEvent EventTagEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Quotas fill in `order`: a registrant takes a place in the first open quota they pass with one left.
model EventRegistrationQuota {
  id      Int    @id @default(autoincrement())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  order   Int
  name    String
  places  Int
  // Price in øre. Set exactly when the event takes payment.
  price   Int?

  registrationStart DateTime
  registrationEnd   DateTime

  visibility   Visibility @relation(name: "EventRegistrationQuotaVisibility", fields: [visibilityId], references: [id], onDelete: Restrict)
  visibilityId Int        @unique

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, order])
}

// IN_QUOTA holds a place and relates to its quota; WAITING_LIST queues and relates to its event.
enum EventRegistrationState {
  IN_QUOTA
  WAITING_LIST
}

model EventRegistration {
  id                 Int                     @id @default(autoincrement())
  state              EventRegistrationState
  quota              EventRegistrationQuota? @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  quotaId            Int?
  waitingListEvent   Event?                  @relation(fields: [waitingListEventId], references: [id], onDelete: Cascade)
  waitingListEventId Int?
  user               User?                   @relation(name: "registration", fields: [userId], references: [id])
  userId             Int?
  contact            ContactDetails?         @relation(fields: [contactId], references: [id])
  contactId          Int?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  note               String?
  // The waiting list queues by this time, then by id.
  queuedAt           DateTime                @default(now())

  // Null until attendance is taken for the event - after that, null means they did not show up.
  attendedAt               DateTime?
  attendanceRegisteredBy   User?     @relation(name: "attendanceRegisteredBy", fields: [attendanceRegisteredById], references: [id], onDelete: SetNull)
  attendanceRegisteredById Int?

  // Paid outside the ledger, for example in person, as marked by an administrator of the event.
  manuallyPaid      Boolean @default(false)

  // Legacy from old database
  company          Boolean @default(false) // This is if a registrations has a plus one.
  extraFieldChoices Json?   @db.Json

  ledgerTransactions LedgerTransaction[]

  @@unique([quotaId, userId])
  @@unique([waitingListEventId, userId])
  @@index([waitingListEventId, queuedAt])
  @@index([userId])
}
