enum EventCanView {
  CAN_REGISTER
  ALL
}

model Event {
  id             Int               @id @default(autoincrement())
  name           String
  paragraph      CmsParagraph      @relation(fields: [cmsParagraphId], references: [id])
  cmsParagraphId Int               @unique
  coverImage     CmsImage          @relation(fields: [coverImageId], references: [id])
  coverImageId   Int               @unique
  eventTagEvents EventTagEvent[]
  location       String?
  locationMap    EventLocationMap?

  eventStart          DateTime
  eventEnd            DateTime
  canBeViewedBy       EventCanView
  hostedByCommittee   Committee?     @relation(fields: [hostedByCommitteeId], references: [id])
  hostedByCommitteeId Int?
  createdBy           User?          @relation(fields: [createdById], references: [id])
  createdById         Int?
  // The account a paid event is paid into. Payments fail with a clear error until someone
  // administrating the event links one.
  ledgerAccount       LedgerAccount? @relation(fields: [ledgerAccountId], references: [id])
  ledgerAccountId     Int?

  variants            EventVariant[]
  waitingList         Boolean
  // Registrants cannot unregister themselves. Only those who administrate the event remove a registration.
  bindingRegistration Boolean        @default(false)
  // Waiting on several variants is always allowed.
  allowRegistrationInMultipleVariants Boolean @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cabinEvent Booking[]

  published Boolean @default(false)

  careerFrontpageHighlights CareerFrontpageHighlight[]

  // The notifications sent to those who may register, or are registered, resolved when they are sent.
  notificationsToWhoCanRegister Notification[]
  notificationsToRegistered     Notification[] @relation(name: "NotificationRegisteredForEvent")

  visibilityAdmin   Visibility @relation(name: "EventAdminVisibility", fields: [visibilityAdminId], references: [id], onDelete: Restrict)
  visibilityAdminId Int        @unique

  // The event's own channel sits under the EVENT channel. The info channel under it is for what the
  // registered need to know, which they are subscribed to as they register; the general one is for the rest.
  notificationChannel          NotificationChannel @relation(name: "EventNotificationChannel", fields: [notificationChannelId], references: [id], onDelete: Restrict)
  notificationChannelId        Int                 @unique
  infoNotificationChannel      NotificationChannel @relation(name: "EventInfoNotificationChannel", fields: [infoNotificationChannelId], references: [id], onDelete: Restrict)
  infoNotificationChannelId    Int                 @unique
  generalNotificationChannel   NotificationChannel @relation(name: "EventGeneralNotificationChannel", fields: [generalNotificationChannelId], references: [id], onDelete: Restrict)
  generalNotificationChannelId Int                 @unique

  // Legacy from OW basic database
  company     Boolean @default(false) // If a plus one is allowed
  lead        String?
  extraFields Json?   @db.Json
}

enum MapProvider {
  MAZEMAP
  OPENSTREETMAP
}

model EventLocationMap {
  eventId   Int         @id
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider  MapProvider
  url       String?
  latitude  Float?
  longitude Float?
}

model EventTagEvent {
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  tag     EventTag @relation(fields: [tagId], references: [id])
  tagId   Int

  @@id([eventId, tagId])
}

enum SpecialEventTags {
  COMPANY_PRESENTATION
}

model EventTag {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  description   String
  colorR        Int
  colorG        Int
  colorB        Int
  special       SpecialEventTags? @unique
  EventTagEvent EventTagEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A way to take part in the event, e.g. "Golfrunde 1" and "Golfrunde 2". Registrants pick one.
model EventVariant {
  id      Int    @id @default(autoincrement())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  order   Int
  name    String

  registrationStart DateTime
  registrationEnd   DateTime

  takesPayment Boolean   @default(false)
  // In øre. Set exactly when the variant takes payment.
  price        Int?
  paymentStart DateTime?
  paymentEnd   DateTime?

  quotas                   EventQuota[]
  waitingListRegistrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, order])
}

// Quotas fill in `order`.
model EventQuota {
  id        Int          @id @default(autoincrement())
  variant   EventVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId Int
  order     Int
  name      String
  places    Int

  visibility   Visibility @relation(name: "EventQuotaVisibility", fields: [visibilityId], references: [id], onDelete: Restrict)
  visibilityId Int        @unique

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, order])
}

enum EventRegistrationState {
  IN_QUOTA
  WAITING_LIST
}

model EventRegistration {
  id                   Int                    @id @default(autoincrement())
  state                EventRegistrationState
  quota                EventQuota?            @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  quotaId              Int?
  waitingListVariant   EventVariant?          @relation(fields: [waitingListVariantId], references: [id], onDelete: Cascade)
  waitingListVariantId Int?
  user                 User?                  @relation(name: "registration", fields: [userId], references: [id])
  userId               Int?
  contact              ContactDetails?        @relation(fields: [contactId], references: [id])
  contactId            Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  note                 String?
  // Queue position within a quota and on the waiting list, by this then id.
  queuedAt             DateTime               @default(now())
  // When the registration last left the waiting list for a place, which gives it time to pay.
  promotedAt           DateTime?

  // Null until attendance is taken for the event - after that, null means they did not show up.
  attendedAt               DateTime?
  attendanceRegisteredBy   User?     @relation(name: "attendanceRegisteredBy", fields: [attendanceRegisteredById], references: [id], onDelete: SetNull)
  attendanceRegisteredById Int?

  // Paid outside the ledger, for example in person, as marked by an administrator of the event.
  manuallyPaid      Boolean @default(false)

  // Legacy from old database
  company          Boolean @default(false) // This is if a registrations has a plus one.
  extraFieldChoices Json?   @db.Json

  ledgerTransactions LedgerTransaction[]

  @@unique([quotaId, userId])
  @@unique([waitingListVariantId, userId])
  @@index([quotaId, queuedAt])
  @@index([waitingListVariantId, queuedAt])
  @@index([userId])
}
