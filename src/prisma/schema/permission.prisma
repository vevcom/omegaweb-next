enum Permission {
  // Job ads
  JOBAD_ADMIN
  JOBAD_USE

  // Omega Quotes
  OMEGAQUOTES_USE

  // Ombul
  OMBUL_ADMIN
  OMBUL_USE

  // Groups
  // There are no generic group permissions: a group is only ever reachable through its own group
  // type, and each group type below carries its own. Reading "all groups" is the union of the group
  // types the session may read, decided per type.
  //
  // Every group type carries the same two: _USE to see it, _ADMIN for everything else - creating,
  // updating, destroying and managing members. Splitting those apart again would mean deciding, per
  // type, which of them a half-administrator should hold, and nothing has ever needed that.

  // omega order
  OMEGA_ORDER_USE
  OMEGA_ORDER_ADMIN

  // Groups - Classes
  CLASS_USE
  CLASS_ADMIN

  // Groups - Committess
  COMMITTEE_USE
  COMMITTEE_ADMIN

  // Groups - InterestGroups
  INTEREST_GROUP_ADMIN
  INTEREST_GROUP_USE

  // Groups - ManualGroups
  MANUAL_GROUP_ADMIN
  MANUAL_GROUP_USE

  // Groups - OmegaMembershipGroup
  OMEGA_MEMBERSHIP_GROUP_USE
  OMEGA_MEMBERSHIP_GROUP_ADMIN

  // Groups - StudyProgramme
  STUDY_PROGRAMME_USE
  STUDY_PROGRAMME_ADMIN

  // Lockers
  LOCKER_ADMIN
  LOCKER_USE

  // Frontpage
  FRONTPAGE_ADMIN

  // User list permissions - theese are admin permissions, and do not have anything
  // to do with a user´s ability to edit its own user.
  // USERS_USE for example means that the user can read the list of users.
  USERS_USE
  USERS_ADMIN

  IMAGE_CREATE
  IMAGE_ADMIN

  EVENT_ADMIN
  EVENT_CREATE

  // Notifications
  NOTIFICATION_ADMIN

  // Mail
  MAIL_USE

  // Mail server: aliases, mailing lists and external addresses
  MAILSERVER_USE
  MAILSERVER_ADMIN

  // Admisstion
  ADMISSION_USE

  // API keys
  APIKEY_ADMIN
  SCREEN_USE
  SCREEN_ADMIN

  // Omega course catalouge
  SCHOOLS_USE
  SCHOOLS_ADMIN

  COURSES_USE
  COURSES_ADMIN

  // Omega job ads
  COMPANY_USE
  COMPANY_ADMIN

  // Dots
  DOTS_ADMIN

  // Cabin
  CABIN_USE
  CABIN_ADMIN

  // Shop
  SHOP_USE
  SHOP_ADMIN

  PRODUCT_USE
  PRODUCT_ADMIN

  PURCHASE_USE
  PURCHASE_ADMIN

  // Image licenses
  LICENSE_ADMIN

  // Permission admin
  PERMISSION_USE
  PERMISSION_ADMIN

  // Applications
  APPLICATION_ADMIN
  APPLICATION_USE

  // New student page
  NEW_STUDENT_ADMIN

  // Report page
  REPORT_ADMIN

  // Ledger permissions
  LEDGER_ADMIN
  LEDGER_USE

  //Flair/badge/cape
  FLAIR_ADMIN

  //Bullshit
  BULLSHIT_WRITE
  BULLSHIT_USE
  // News
  NEWS_CREATE
  NEWS_ADMIN

  // Article categories
  ARTICLE_CATEGORY_ADMIN
}

model GroupPermission {
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    Int
  permission Permission

  @@unique([groupId, permission])
}

model DefaultPermission {
  permission Permission @unique
}
