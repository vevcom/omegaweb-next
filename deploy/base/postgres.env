# The one place the Postgres version lives. Kustomize puts POSTGRES_IMAGE into the Cluster in
# database.yaml, and docker compose builds the dev and test image from POSTGRES_VERSION, so the
# npm scripts and the workflows pass this file as a second --env-file. Bump both lines together.
POSTGRES_VERSION=18.6
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-system-trixie
