############
# API Keys #
############

# Feide 
FEIDE_CLIENT_ID=<INSERT>
FEIDE_CLIENT_SECRET=<INSERT>

# Stripe
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

############
# Database #
############

# Omegaweb Next's DB
DB_NAME=devdb
DB_USERNAME=user
DB_PASSWORD=password
POSTGRES_HOST=db

DB_URI="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${POSTGRES_HOST}:5432/${DB_NAME}"

###########
# Logging #
###########

LOG_TO_CONSOLE=true
LOG_CONSOLE_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_LEVEL=info
LOG_TO_FOLDER=true
LOG_MAX_FILES=365d

##################
# Authentication #
##################

# The secrets below and the Omega ID keys are development values. Production refuses to start
# with them (src/lib/productionSecrets.ts).

# Signing in happens on the auth domain of sites.json, and every other domain gets its own session
# cookie from it through the app's OpenID Connect provider, see README.md. NextAuth takes its url
# from the host each request came to, so it serves them all alike. NEXTAUTH_URL stays unset: set,
# it pins NextAuth to one domain.
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=cake_is_love_cake_is_life

# Password Hashing and Encryption
PASSWORD_SALT_ROUNDS="12"
PASSWORD_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" # Must be 256 bits (43 characters) long

# API Key Hashing and Encryption
API_KEY_SALT_ROUNDS="12"
API_KEY_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" # Must be 256 bits (43 characters) long

# Server Actions encryption key. Baked in during build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" # base64, must decode to 16, 24 or 32 bytes

##########
# E-mail #
##########

# The server the app sends mail through. Left empty, development sends through Ethereal, which
# logs a preview url for every mail. Set, the server is used in every environment. The values below
# are for the mail server of `npm run docker:dev -- --mail`: set EMAIL_SERVER=stalwart to send through
# it, and EMAIL_ADMIN_URL below to keep its aliases in step.
# That server takes the app's mail on port 2525 with no login, so there is no user or password here.
# A server that asks for a login gets EMAIL_USER and EMAIL_PASSWORD.
EMAIL_SERVER=
EMAIL_PORT=2525
EMAIL_SECURE=false
# The dev mail server's certificate is self-signed, so it is not verified. A server reached by another
# name than its certificate is for, as production's is inside the cluster, is verified by setting
# EMAIL_TLS_SERVERNAME to the name on the certificate, with EMAIL_TLS_ALLOW_SELF_SIGNED left out.
EMAIL_TLS_ALLOW_SELF_SIGNED=true
# The management API of that server, for keeping its mailing lists in step with the aliases here.
# Left empty, nothing is synced. The values are for the dev mail server, at http://stalwart:8080.
EMAIL_ADMIN_URL=
EMAIL_ADMIN_USER=admin
EMAIL_ADMIN_PASSWORD=omegaweb-dev-admin
# The webmail of that server, where everyone who receives an alias's mail reads its mailbox. Its host
# is also the domain of the accounts that sign in there. Left empty, no alias has a mailbox. The value
# is the webmail of the dev mail server.
EMAIL_WEBMAIL_URL=http://mail.omegaweb.localhost:8081
# The mail domains are the domains of the sites, see sites.json.

########
# Chat #
########

# Where the chat signs its users in: MAS, as browsers reach it, see chat-infrastructure. It signs
# them in through this app, as a client named by its host. Left empty, there is no chat to sign in
# to. The value is that of the chat of `npm run docker:dev -- --chat`.
CHAT_AUTH_URL=http://account.chat.localhost:8091

#########
# Store #
#########

# The S3 bucket of the store, which keeps uploaded images and ombul pdfs. Left empty, every file is
# in the store/ directory, which is what development uses. With a bucket, each kind of file is in
# the bucket or in store/ as the code says for it, and the store's workers move the files that are
# in the other one, so nothing has to be copied when a bucket is set. Unsetting a bucket that holds
# files leaves them unreachable, so it is emptied first, see "The store" in deploy/README.md.
# Production uses NTNU's object storage at https://s3.stack.it.ntnu.no, with keys from
# `openstack ec2 credentials create`.
STORE_S3_ENDPOINT=
STORE_S3_REGION=
STORE_S3_BUCKET=
STORE_S3_ACCESS_KEY_ID=
STORE_S3_SECRET_ACCESS_KEY=

######################
# Push notifications #
######################

# The key pair push notifications are signed with, known as VAPID keys. This is a dev pair, so
# generate a new one with `npx web-push generate-vapid-keys` for any other environment. Browsers
# subscribe with the public key, so replacing the pair cuts off every saved push subscription.
VAPID_PUBLIC_KEY=BIcqE107sLjdbC6vJ8MUjI7FdRXRtsy6DH8g9tE7k8Ml_zeQnMWwZOCxbCJ_hFEjqrmL71KwWJ7kdbGiZmGlicM
VAPID_PRIVATE_KEY=uoIpSm5x5SX8QApWaDWsz815nQhVtfVq9WALwn4yxP8

############
# Omega ID #
############

# PEM keys are stored as base64 rather than raw multi-line text - some
# platform env-var UIs auto-resolve \n escapes back into
# real newlines when saving, which breaks the .env file's line-based format
# the same way an unescaped multi-line value does. Base64 leaves nothing for
# a UI to "helpfully" reinterpret. readPemEnvBase64() decodes it back to PEM.
# (this is the base64 of the same dev EC key pair as before)
# (This is a ES256 key)
# The same pair signs the tokens of the OpenID Connect provider, published at /api/oidc/jwks.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFV2RxMDZ4L2xIZUlmaXV2eUo4ejdXK3hwQVd2VAp1bS94eXcvbktGSmNxcU1KNzFYcTNTWStuQTdJMHVpNFI0VzZ1c3g5SGU2a2I1RUtsemM5RWRWcTB3PT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg=="
JWT_SECRET="hs_maa_gaa"
