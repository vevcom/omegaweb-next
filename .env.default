###############
# Server info #
###############

WEBSITE_DOMAIN=omega.ntnu.no
WEBSITE_URL=http://localhost:80

############
# API Keys #
############

# Feide 
FEIDE_CLIENT_ID=<INSERT>
FEIDE_CLIENT_SECRET=<INSERT>

# Stripe
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

############
# Database #
############

# Omegaweb Next's DB
DB_NAME=devdb
DB_USERNAME=user
DB_PASSWORD=password
POSTGRES_HOST=db

DB_URI="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${POSTGRES_HOST}:5432/${DB_NAME}"

###########
# Logging #
###########

LOG_TO_CONSOLE=true
LOG_CONSOLE_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_LEVEL=info
LOG_TO_FOLDER=true
LOG_MAX_FILES=365d

##################
# Authentication #
##################

# The secrets below and the Omega ID keys are development values. Production refuses to start
# with them (src/lib/productionSecrets.ts).

# NextAuth
NEXTAUTH_URL="http://localhost"
NEXTAUTH_SECRET=cake_is_love_cake_is_life

# Release countdown (press space on the countdown for the admin panel: the password gets you past
# the countdown, and lets you change the release date, open the site to all and update the git graph)
RELEASE_COUNTDOWN_PASSWORD=omega
# Optional. The git graph is fetched from GitHub, about one request per hundred commits, and without
# a token GitHub allows 60 an hour per address.
GITHUB_TOKEN=

# Password Hashing and Encryption
PASSWORD_SALT_ROUNDS="12"
PASSWORD_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" # Must be 256 bits (43 characters) long

# API Key Hashing and Encryption
API_KEY_SALT_ROUNDS="12"
API_KEY_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" # Must be 256 bits (43 characters) long

# Server Actions encryption key. Baked in during build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" # base64, must decode to 16, 24 or 32 bytes

##########
# E-mail #
##########

EMAIL_SERVER=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_TLS_ALLOW_SELF_SIGNED=false
EMAIL_USER=<INSERT>
EMAIL_PASSWORD=<INSERT>
EMAIL_DOMAIN=omega.ntnu.no
EMAIL_HOSTNAME=sanctus.omega.ntnu.no
EMAIL_RELAY_HOST=mailgw.ntnu.no

######################
# Push notifications #
######################

# The key pair push notifications are signed with, known as VAPID keys. This is a dev pair, so
# generate a new one with `npx web-push generate-vapid-keys` for any other environment. Browsers
# subscribe with the public key, so replacing the pair cuts off every saved push subscription.
VAPID_PUBLIC_KEY=BIcqE107sLjdbC6vJ8MUjI7FdRXRtsy6DH8g9tE7k8Ml_zeQnMWwZOCxbCJ_hFEjqrmL71KwWJ7kdbGiZmGlicM
VAPID_PRIVATE_KEY=uoIpSm5x5SX8QApWaDWsz815nQhVtfVq9WALwn4yxP8

############
# Omega ID #
############

# PEM keys are stored as base64 rather than raw multi-line text - some
# platform env-var UIs (Dokploy included) auto-resolve \n escapes back into
# real newlines when saving, which breaks the .env file's line-based format
# the same way an unescaped multi-line value does. Base64 leaves nothing for
# a UI to "helpfully" reinterpret. readPemEnvBase64() decodes it back to PEM.
# (this is the base64 of the same dev EC key pair as before)
# (This is a ES256 key)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFV2RxMDZ4L2xIZUlmaXV2eUo4ejdXK3hwQVd2VAp1bS94eXcvbktGSmNxcU1KNzFYcTNTWStuQTdJMHVpNFI0VzZ1c3g5SGU2a2I1RUtsemM5RWRWcTB3PT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg=="
JWT_SECRET="hs_maa_gaa"
