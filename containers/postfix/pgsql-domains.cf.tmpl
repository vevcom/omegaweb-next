#
# pgsql config file for virtual_alias_domains: the domains mail is received on
#

hosts = {{ .Env.POSTGRES_HOST }}
user = {{ .Env.POSTGRES_USER }}
password = {{ .Env.POSTGRES_PASSWORD }}
dbname = {{ .Env.POSTGRES_DB }}

# Every domain an alias is on. The app only allows aliases on the domains of the sites (sites.json),
# so a domain added there is received here once it has an alias. The server's own name is left out,
# since it is in mydestination and a domain may only be in one of the lists.
query = SELECT DISTINCT lower(split_part("address", '@', 2)) FROM "MailAlias" WHERE lower(split_part("address", '@', 2)) = lower('%s') AND lower('%s') <> lower('{{ .Env.EMAIL_HOSTNAME }}')
